{# 관리자 접속 파일의 읽기 권한과 Secret 저장 시 암호화를 설정한다. 실제 상태는 tasks에서 검사한다. #}
write-kubeconfig-mode: '0600'
secrets-encryption: true
cluster-cidr: {{ k3s_cluster_cidr | quote }}
service-cidr: {{ k3s_service_cidr | quote }}
{# 호스트 자원 예약·디스크/메모리 퇴거 기준·컨테이너 로그 회전으로 단일 노드 고갈을 줄인다. #}
kubelet-arg:
  - system-reserved=cpu={{ k3s_system_reserved_cpu }},memory={{ k3s_system_reserved_memory }}
  - "eviction-hard=memory.available<{{ k3s_eviction_memory_available }},nodefs.available<{{ k3s_eviction_nodefs_available }},imagefs.available<{{ k3s_eviction_imagefs_available }},nodefs.inodesFree<{{ k3s_eviction_nodefs_inodes_free }},imagefs.inodesFree<{{ k3s_eviction_imagefs_inodes_free }}"
  - container-log-max-size=10Mi
  - container-log-max-files=5
