apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: traefik
  namespace: kube-system
spec:
  valuesContent: |-
    # 앱 Ingress의 rate limit이 공격 트래픽을 받아내는 동안 Traefik이 노드 메모리를 무제한으로 쓰지 않게 한다.
    # CPU limit은 두지 않아 TLS 처리량이 몰릴 때 throttling으로 정상 요청까지 늦어지지 않게 한다.
    resources:
      requests:
        cpu: 100m
        memory: 128Mi
      limits:
        memory: 512Mi
    # ServiceLB·NodePort의 전달 트래픽은 UFW만으로 막히지 않으므로 Service 노출도 제한한다.
    service:
      spec:
        allocateLoadBalancerNodePorts: false
        # 단일 노드라 트래픽 쏠림 문제 없음. Local로 바꿔야 accessLog에
        # 실제 클라이언트 IP가 남고, 기본값(Cluster)은 SNAT되어 원본 IP가 사라짐.
        externalTrafficPolicy: Local
    ports:
      web:
        expose:
          default: false
      websecure:
        forwardedHeaders:
          insecure: false
          trustedIPs: []
    # 9/16 OOM 인시던트 후속 조치: 원본 IP 확보용 accessLog 활성화.
    # 헤더는 기본 drop(개인정보 최소화), ClientHost 등 핵심 필드는 기본 포함됨.
    # 주의: Loki로 자동 수집되지 않고 Pod stdout에만 남음(kubectl logs로만 확인 가능,
    # Pod 재시작 시 유실). Loki 영구 저장은 별도 filelog receiver 추가가 필요함.
    logs:
      access:
        enabled: true
        format: json
        fields:
          headers:
            defaultmode: drop
